FACULTAS {
    atramentum "rex" 2;
}

CIRCULUS RITU goetia {
    INTENTIO "favour of friends and foes";
    GERE ANULUM;
    GERE VIRGAM;
    GERE HEXAGRAMMUM;
    GERE PENTAGRAMMUM;
    SIT sigillum = INSCRIBE SIGILLUM belial ATRAMENTO CONSECRA ATRAMENTUM "rex";
    SIT vocatus = INVOCA SPIRITUS 68 AD OFFICIUM concordia;
    OFFER vocatus;
    CONSTRINGE vocatus PER NOMEN "Tetragrammaton";
    APPELLA vocatus;
    VETA vocatus;
    SIT p = PETE vocatus();
    SI EXAMINA p == RATUM { VADE IN PACE vocatus; } ALITER { RELEGA vocatus; }
}
